{
  "name": "@agentfile/cli",
  "version": "0.4.0",
  "description": "CLI for agentfile — init, migrate, sync, validate, watch, diff, clean, rollback, and ui",
  "type": "module",
  "main": "./dist/bin.js",
  "bin": {
    "agentfile": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "rules",
    "claude",
    "copilot",
    "cursor",
    "agentfile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennishavermans/agentfile.git"
  },
  "homepage": "https://github.com/dennishavermans/agentfile#readme",
  "bugs": {
    "url": "https://github.com/dennishavermans/agentfile/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentfile/core": "^0.4.0",
    "@agentfile/ui": "^0.1.0-beta.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
