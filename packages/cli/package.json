{
  "name": "@agentfile/cli",
  "version": "2.1.1",
  "description": "Find what is wrong with the AI agent configuration your repository already has — doctor, check, lint, audit, adopt, compile, eval",
  "type": "module",
  "main": "./dist/bin.js",
  "bin": {
    "agentfile": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "rules",
    "claude",
    "copilot",
    "cursor",
    "agentfile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennishavermans/agentfile.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dennishavermans/agentfile#readme",
  "bugs": {
    "url": "https://github.com/dennishavermans/agentfile/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentfile/core": "^2.1.1",
    "chalk": "^6.0.0",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@agentfile/ui": "^0.1.0-beta.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@agentfile/ui": "^0.1.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@agentfile/ui": {
      "optional": true
    }
  },
  "author": "Dennis Havermans"
}
