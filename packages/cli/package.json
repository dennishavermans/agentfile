{
  "name": "@agentfile/cli",
  "version": "0.2.0",
  "description": "CLI for agentfile — init, sync, and validate AI agent contracts",
  "type": "module",
  "main": "./dist/bin.js",
  "bin": {
    "agentfile": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "rules",
    "claude",
    "copilot",
    "cursor",
    "agentfile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennishavermans/agentfile"
  },
  "homepage": "https://github.com/dennishavermans/agentfile#readme",
  "bugs": {
    "url": "https://github.com/dennishavermans/agentfile/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentfile/core": "^0.2.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
