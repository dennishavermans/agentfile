{
  "name": "@agentfile/core",
  "version": "2.0.1",
  "description": "Read, analyse and compile AI agent configuration — discovery, a normalized IR, a resolver, diagnostics, and static security analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "bench": "tsx benchmarks/core.bench.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "agents",
    "rules",
    "claude",
    "copilot",
    "cursor",
    "agentfile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennishavermans/agentfile.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/dennishavermans/agentfile#readme",
  "bugs": {
    "url": "https://github.com/dennishavermans/agentfile/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "author": "Dennis Havermans"
}
