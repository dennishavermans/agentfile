{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "NodeNext",
    "moduleResolution":"NodeNext",
    "outDir":          "./dist",
    "rootDir":         "./src",
    "declaration":     true,
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "types":           ["node"],
    "typeRoots":       ["../../node_modules/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
